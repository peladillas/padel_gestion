APP_NAME=Bonapinta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bonapinta
DB_USERNAME=bonapinta
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# --- Only relevant if you ever swap FILESYSTEM_DISK/CACHE_STORE for
# redis or memcached — the app itself doesn't use either. Kept from
# Laravel's stock template, not Bonapinta-specific.
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log means every "sent" email is written to
# storage/logs/laravel.log instead of actually calling Resend — safe
# default for local dev. Set to anything else (e.g. "resend") to send
# for real, and RESEND_API_KEY must then be a valid key.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@bonapinta.com
MAIL_FROM_NAME="Bonapinta"

# --- Bonapinta-specific (mirrors backend/src/config/index.js — same
# var names on purpose, see config/bonapinta.php) ---
# Must match whatever backend/ (the Express app) is issuing/verifying
# JWTs with, if the two are ever run side by side against the same
# users. Generate a real random value for anything beyond local dev —
# never reuse the one in CLAUDE.md outside this project's own local/
# staging use.
JWT_SECRET=
JWT_EXPIRY=7d
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) API key. Get the real value from
# whoever holds the project's Resend account, or from CLAUDE.md if
# you already have repo access — never commit the actual key here.
RESEND_API_KEY=
EMAIL_FROM=noreply@bonapinta.com

# Hardcoded upstream too (see AvailabilityService.js /
# config/bonapinta.php's docblock) — availability is intentionally not
# season-scoped, so this only needs to point at *a* valid Season row.
BONAPINTA_DEFAULT_SEASON_ID=1f481f07-1eda-48ed-84f2-3e808004b3ad
