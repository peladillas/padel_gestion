# Copy to `.env` (git-ignored) on the server and fill in EVERY value.
# Generate secrets with:  openssl rand -hex 32   (APP_KEY: see below)

# ── Postgres ─────────────────────────────────────────────
POSTGRES_DB=bonapinta
POSTGRES_USER=bonapinta
POSTGRES_PASSWORD=

# ── Laravel API ──────────────────────────────────────────
# php artisan key:generate --show   (or: echo "base64:$(openssl rand -base64 32)")
APP_KEY=
APP_URL=https://bonapinta.com
FRONTEND_URL=https://bonapinta.com

# ≥ 32 chars. Changing it logs every user out.
JWT_SECRET=
JWT_EXPIRY=7d

# Emails (verification, invitations, password reset). Must be "resend" in production.
MAIL_MAILER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@bonapinta.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Behind the Docker nginx every request comes from the proxy; trust it so
# per-IP rate limits see the real client ("*" is fine inside this network).
TRUSTED_PROXIES=*
